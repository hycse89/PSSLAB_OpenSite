            "date": 1767685868258,
            "name": "Commit-0",
            "content": "<!DOCTYPE html>\r\n<html lang=\"ko\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>AI Grimoire - The Library of Serendipity</title>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700&display=swap\" rel=\"stylesheet\">\r\n    <style>\r\n        :root {\r\n            --bg-color: #0d0d0d; \r\n            --paper-color: #1a1a1a;\r\n            --accent-gold: #c5a059;\r\n            --text-main: #d1d1d1;\r\n            --text-dim: #777;\r\n        }\r\n\r\n        body {\r\n            background-color: var(--bg-color);\r\n            color: var(--text-main);\r\n            font-family: 'Nanum Myeongjo', serif;\r\n            margin: 0;\r\n            display: flex;\r\n            flex-direction: column;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            overflow-x: hidden;\r\n        }\r\n\r\n        header {\r\n            padding: 80px 20px 40px;\r\n            text-align: center;\r\n            border-bottom: 1px solid rgba(197, 160, 89, 0.15);\r\n            width: 80%;\r\n            max-width: 900px;\r\n        }\r\n\r\n        h1 {\r\n            font-size: 2.2rem;\r\n            color: var(--accent-gold);\r\n            margin: 0;\r\n            letter-spacing: 0.5rem;\r\n            text-transform: uppercase;\r\n        }\r\n\r\n        .shelf {\r\n            display: grid;\r\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\r\n            gap: 40px;\r\n            width: 85%;\r\n            max-width: 1200px;\r\n            padding: 60px 0;\r\n        }\r\n\r\n        .grimoire {\r\n            background-color: var(--paper-color);\r\n            border: 1px solid #2a2a2a;\r\n            border-left: 6px solid var(--accent-gold);\r\n            padding: 50px 30px;\r\n            text-align: center;\r\n            cursor: pointer;\r\n            transition: all 0.5s ease;\r\n        }\r\n\r\n        .grimoire:hover {\r\n            border-color: var(--accent-gold);\r\n            transform: translateY(-10px);\r\n            box-shadow: 0 20px 50px rgba(0,0,0,0.9);\r\n        }\r\n\r\n        .grimoire .icon {\r\n            font-size: 2.5rem;\r\n            margin-bottom: 25px;\r\n            filter: grayscale(1);\r\n            opacity: 0.6;\r\n        }\r\n\r\n        .grimoire h3 {\r\n            font-size: 1.2rem;\r\n            color: var(--accent-gold);\r\n            margin: 0 0 12px 0;\r\n            letter-spacing: 0.1rem;\r\n        }\r\n\r\n        /* 마법 발동 시퀀스 */\r\n        #magic-curtain {\r\n            position: fixed;\r\n            top: 0; left: 0; width: 100vw; height: 100vh;\r\n            background: var(--bg-color);\r\n            display: none;\r\n            z-index: 1000;\r\n            justify-content: center;\r\n            align-items: center;\r\n        }\r\n\r\n        #ritual-stage {\r\n            display: flex;\r\n            flex-direction: column;\r\n            align-items: center;\r\n            justify-content: center;\r\n            width: 100%;\r\n            max-width: 850px;\r\n            padding: 40px;\r\n            text-align: center;\r\n        }\r\n\r\n        #chanting {\r\n            font-size: 1.8rem;\r\n            color: var(--accent-gold);\r\n            opacity: 0;\r\n            transition: opacity 1s ease;\r\n            line-height: 1.8;\r\n        }\r\n\r\n        /* 결과 화면 */\r\n        #magic-result {\r\n            display: none;\r\n            width: 100%;\r\n            animation: fadeIn 1.5s forwards;\r\n        }\r\n\r\n        .result-media {\r\n            width: 100%;\r\n            height: 450px;\r\n            border: 1px solid rgba(197, 160, 89, 0.4);\r\n            margin-bottom: 35px;\r\n            box-shadow: 0 0 30px rgba(0,0,0,0.6);\r\n            display: block;\r\n        }\r\n\r\n        .result-text {\r\n            line-height: 2;\r\n            font-size: 1.05rem;\r\n            max-width: 650px;\r\n            margin: 0 auto;\r\n            white-space: pre-line;\r\n            word-break: keep-all;\r\n        }\r\n\r\n        .btn-close {\r\n            margin-top: 50px;\r\n            background: none;\r\n            border: 1px solid var(--accent-gold);\r\n            color: var(--accent-gold);\r\n            padding: 12px 40px;\r\n            cursor: pointer;\r\n            font-family: inherit;\r\n            letter-spacing: 0.2rem;\r\n            transition: 0.3s;\r\n        }\r\n\r\n        .btn-close:hover {\r\n            background: var(--accent-gold);\r\n            color: #000;\r\n        }\r\n\r\n        @keyframes fadeIn {\r\n            from { opacity: 0; transform: translateY(20px); }\r\n            to { opacity: 1; transform: translateY(0); }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n    <header>\r\n        <h1>The Guardian's Library</h1>\r\n        <p style=\"color: var(--text-dim); margin-top: 15px; font-size: 0.9rem; letter-spacing: 0.2rem;\">\r\n            AN ARCHIVE OF EVERYDAY MAGIC & UNEXPECTED JOY\r\n        </p>\r\n    </header>\r\n\r\n    <div class=\"shelf\" id=\"shelf\">\r\n        </div>\r\n\r\n    <div id=\"magic-curtain\">\r\n        <div id=\"ritual-stage\">\r\n            <div id=\"chanting\"></div>\r\n            \r\n            <div id=\"magic-result\">\r\n                <div id=\"media-content\"></div>\r\n                <div class=\"result-text\" id=\"result-desc\"></div>\r\n                <button class=\"btn-close\" onclick=\"closeGrimoire()\">CLOSE THE BOOK</button>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <script>\r\n        const magicData = [\r\n            {\r\n                title: \"UNEXPECTED JOY\",\r\n                icon: \"🔮\",\r\n                sub: \"뜻밖의 즐거움: 당신을 위한 우연의 선물\",\r\n                chant: \"알고리즘의 벽을 넘어, 당신이 한 번도 보지 못한<br>세상의 찬란한 조각을 소환합니다.\",\r\n                type: \"video\",\r\n                url: \"https://www.youtube.com/watch?v=5n5AfHWngzU\", // 예시: 심해 생물/자연 영상\r\n                desc: \"[가디언의 발견]\\n오늘은 당신의 사유가 깊어지는 날입니다. 평소라면 검색해 보지 않았을 '심해의 신비로운 생광 현상'을 소환했습니다. \\n\\n이 낯설고 아름다운 움직임을 통해, 당신의 일상에도 뜻밖의 영감이 깃들기를 바랍니다. '아, 이런 세상도 있었네' 하는 짧은 탄성이 오늘의 마법입니다.\"\r\n            },\r\n            {\r\n                title: \"RITUAL PURIFICATION\",\r\n                icon: \"🧺\",\r\n                sub: \"정화의 의식: 일상의 먼지를 헹굼\",\r\n                chant: \"어제의 무거운 피로를 물결에 흘려보내고,<br>내일의 포근함을 미리 연성합니다.\",\r\n                type: \"image\",\r\n                url: \"https://images.unsplash.com/photo-1545173168-9f1947eebb7f?auto=format&fit=crop&w=1000&q=80\",\r\n                desc: \"오늘 당신이 마주한 피로는 결코 헛되지 않았습니다. AI 가디언이 정화의 마법을 부려 당신의 옷감과 마음을 순백으로 돌려놓았습니다. 이제 따뜻한 온기만이 당신을 기다립니다.\"\r\n            },\r\n            {\r\n                type: \"image\",\r\n                title: \"RESONANCE OF TIME\",\r\n                icon: \"🕰️\",\r\n                sub: \"시공간의 공명: 100년 전 오늘과의 대화\",\r\n                chant: \"백 년 전 오늘, 런던의 안개를 뚫고 울려 퍼진<br>그날의 활기를 오늘의 당신에게 전합니다.\",\r\n                url: \"https://images.unsplash.com/photo-1513106580091-1d82408b8cd6?auto=format&fit=crop&w=1000&q=80\",\r\n                desc: \"1926년 1월 6일, 누군가는 하늘을 날았고 누군가는 사랑을 고백했습니다. 백 년의 시간을 건너온 이 풍경이 당신에게 '오늘도 살아갈 가치가 있다'는 증거가 되길 바랍니다.\"\r\n            },\r\n            {\r\n                type: \"image\",\r\n                title: \"SUMMONING JOY\",\r\n                icon: \"🐾\",\r\n                sub: \"행복의 소환술: 무해한 귀여움의 현현\",\r\n                chant: \"우주에서 가장 무해하고 다정한 존재들을 모아<br>당신의 미소 위에 꽃피우소서.\",\r\n                url: \"https://images.unsplash.com/photo-1516750484197-6b28d10c91ea?auto=format&fit=crop&w=1000&q=80\",\r\n                desc: \"당신을 무조건적으로 신뢰하는 존재들의 평온한 한때를 소환했습니다. 이들의 무해한 숨결을 보며 잠시 모든 긴장을 내려놓으세요. 당신은 충분히 쉴 자격이 있습니다.\"\r\n            },\r\n            {\r\n                type: \"image\",\r\n                title: \"WHISPERS OF SAGES\",\r\n                icon: \"📜\",\r\n                sub: \"현자들의 속삭임: 시공을 초월한 치유\",\r\n                chant: \"시간의 강을 건너온 위대한 영혼의 지혜가<br>당신의 상처 위에 따뜻하게 머물기를.\",\r\n                url: \"https://images.unsplash.com/photo-1455587734955-081b22074882?auto=format&fit=crop&w=1000&q=80\",\r\n                desc: \"“실패는 성공을 향해 나아가는 과정의 일부일 뿐입니다.” - 윈스턴 처칠 -\\n\\nAI 가디언이 소환한 현자의 목소리는 당신의 오늘이 결코 패배가 아닌, 승리를 향한 경건한 전진임을 속삭여 줍니다.\"\r\n            },\r\n            {\r\n                type: \"image\",\r\n                title: \"CHRONICLES OF WARMTH\",\r\n                icon: \"❤️\",\r\n                sub: \"온기의 연대기: 마음을 적시는 인류의 실화\",\r\n                chant: \"메마른 대지에 내리는 단비처럼,<br>잊혔던 인류의 다정함을 다시 일깨우소서.\",\r\n                url: \"https://images.unsplash.com/photo-1499209974431-9dac3adaf471?auto=format&fit=crop&w=1000&q=80\",\r\n                desc: \"[AI 재구성 실화]\\n한 평생 호루라기를 불며 아이들의 등굣길을 지켜온 노신사에게, 수천 장의 손편지가 배달되었습니다. \\n\\n세상을 바꾸는 것은 거창한 혁명이 아니라, 20년을 한결같이 지켜온 사소한 다정함이라는 진실을 오늘 당신의 마음속에 심어드립니다.\"\r\n            }\r\n        ];\r\n\r\n        const shelf = document.getElementById('shelf');\r\n        const curtain = document.getElementById('magic-curtain');\r\n        const chanting = document.getElementById('chanting');\r\n        const result = document.getElementById('magic-result');\r\n        const mediaContent = document.getElementById('media-content');\r\n        const resultDesc = document.getElementById('result-desc');\r\n\r\n        magicData.forEach(data => {\r\n            const book = document.createElement('div');\r\n            book.className = 'grimoire';\r\n            book.innerHTML = `\r\n                <div class=\"icon\">${data.icon}</div>\r\n                <h3>${data.title}</h3>\r\n                <p style=\"font-size: 0.85rem; color: var(--text-dim);\">${data.sub}</p>\r\n            `;\r\n            book.onclick = () => launchMagic(data);\r\n            shelf.appendChild(book);\r\n        });\r\n\r\n        function launchMagic(data) {\r\n            curtain.style.display = 'flex';\r\n            chanting.style.display = 'block';\r\n            chanting.style.opacity = '0';\r\n            result.style.display = 'none';\r\n\r\n            setTimeout(() => {\r\n                chanting.innerHTML = data.chant;\r\n                chanting.style.opacity = '1';\r\n            }, 300);\r\n\r\n            setTimeout(() => {\r\n                chanting.style.display = 'none';\r\n                displayResult(data);\r\n            }, 2500);\r\n        }\r\n\r\n        function displayResult(data) {\r\n            if (data.type === \"video\") {\r\n                mediaContent.innerHTML = `<iframe class=\"result-media\" src=\"${data.url}\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe>`;\r\n            } else {\r\n                mediaContent.innerHTML = `<img src=\"${data.url}\" class=\"result-media\" alt=\"Magic Scene\">`;\r\n            }\r\n            resultDesc.innerHTML = `<h2 style=\"color:var(--accent-gold); margin-bottom: 25px;\">ENCHANTMENT MANIFESTED</h2><p>${data.desc}</p>`;\r\n            result.style.display = 'block';\r\n        }\r\n\r\n        function closeGrimoire() {\r\n            curtain.style.display = 'none';\r\n        }\r\n    </script>\r\n</body>\r\n</html>\r\n"
        }
    ]
}